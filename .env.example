# Copy this file to .env and fill in your Supabase project's values.
# Both of these are PUBLIC by design (safe to ship in the frontend bundle) —
# they have no access beyond what Row Level Security policies explicitly grant.
# Never put a service-role/admin key in a VITE_-prefixed variable.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
